@*make navbar glow on roght page*@
<style>
    #Payments {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Payments:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>

<body>

<div class="mainAppSpace">
    <div class="applicationBox">
        <div class="paymentTypeButtons">
            <a class="paymentButton" asp-action="ChooseExternal">Transfer To External Accounts (other peoples samolut accounts)</a>
            <a class="paymentButton" asp-action="TransferBankToCurrency">Transfer Money From Your Bank Accounts To Your Currency Accounts</a>
            <a class="paymentButton" asp-action="TransferInternalCurrency">Transfer Between Your Currency Accounts</a>
            @* different id for withdraw as i want it to be red*@
            <a class="paymentButton" id="withdrawButton" asp-action="TransferWithdrawToBank">Withdraw from currency accounts to Bank</a>
        </div>

    </div>
</div>
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}