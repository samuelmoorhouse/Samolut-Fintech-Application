@model Samolut_Fintech_Application.Models.Transfers.InternalCurrencyModel
@*make navbar glow on roght page*@
<style>
    #Payments {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Payments:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>

<body>
    <div class="topDisplay">
        <h2>Samolut Payments</h2>
    </div>

    <div class="mainAppSpace">
        <div class="applicationBox">
            
            @* learnt tht these are razor comments and they can be used anywhere and dont show on inspect element*@
            
                <div class="TransferBox">
                    <form asp-action="CalculateCurrency" method="post">
                        @Html.AntiForgeryToken()

                        
                        <div class="leftTransferBox">
                        
                            <label class="transactionText" for="SENDER_ACCOUNT_ID">Currency Account to Withdraw Money from.</label><br/>
                            <select class="accountsTransactionSelect" asp-for="SENDER_ACCOUNT_ID" id="SENDER_ACCOUNT_ID" name="SENDER_ACCOUNT_ID" required>
                                <option value="">Select Currency Account</option>
                                @{
                                    foreach(var i in ViewBag.accounts)
                                    {
                                        <option value="@i.ACCOUNT_ID">@i.CurrencyIdForeignKey.COUNTRY_CURRENCY_NAME - @i.CurrencyIdForeignKey.CURRENCY_ICON@i.ACCOUNT_BALANCE</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SENDER_ACCOUNT_ID" class="errorMessages"></span><br />
                        
                        
                            <label class="transactionText" for="AMOUNT">Amount to Send </label>
                            <input class="accountsTransactionAmount" asp-for="AMOUNT" name="AMOUNT" type="number" step="0.01" placeholder="0.00" required/>
                            <span asp-validation-for="AMOUNT" class="errorMessages"></span><br />
                        
                        </div>
                        
                        <div class="rightTransferBox">

                        
                        
                            <label class="transactionText" for="RECEIVER_ACCOUNT_ID">Bank Account to Receive Money</label>
                            <select class="accountsTransactionSelect" asp-for="RECEIVER_ACCOUNT_ID" id="RECEIVER_ACCOUNT_ID" name="RECEIVER_ACCOUNT_ID" required>
                                <option value="">Select Bank Account: </option>
                                @{
                                    foreach (var i in ViewBag.bankAccounts)
                                    {
                                        <option value="@i.ACCOUNT_ID">@i.ACCOUNT_NAME - @i.CurrencyIdForeignKey.CURRENCY_ICON@i.ACCOUNT_BALANCE</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="RECEIVER_ACCOUNT_ID" class="errorMessages"></span><br />
                        
                        
                            <label class="transactionText" for="calculateButton">Calculate</label>
                            <button name="calculateButton" class="transactionCalculateButton" class="SendMoneySubmit" type="submit">Calculate</button><br/>
                            <span class="errorMessages">@ViewBag.ErrorMessage</span>
                        </div>
                        
                    </form>
                </div>
            
                

        </div>
    </div>
                    
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}