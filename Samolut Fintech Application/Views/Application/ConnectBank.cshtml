@model Samolut_Fintech_Application.Models.Transfers.AddBankModel
@*make navbar glow on roght page*@
<style>
    #Add {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Add:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>

<body>
<div class="topDisplay">
    <h2>Samolut Payments</h2>
</div>

<div class="mainAppSpace">
    <div class="applicationBox">
    <div class="placeConfirmBox">
        <div class="confirmInfoBox"> 
            <div class="TransferBox">
                <form id="AddcurrencyForm" asp-action="ConnectBank" method="post">
                    @Html.AntiForgeryToken()


                    <label class="confirmText" for="BANK_ID">Choose a Bank account to connect to Samolut</label><br/>
                    @*display the bank accounts they can have*@
                    <select class="accountsTransactionSelect" asp-for="BANK_ID" id="BANK_ID" name="BANK_ID" required>
                        <option value="">Select Bank to Connect</option>
                        @{
                            foreach (var i in ViewBag.bankAccounts) @*so recipients instead of just accounts*@
                            {
                                <option value="@i.BANK_ID">@i.ACCOUNT_NAME</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="BANK_ID" class="errorMessages"></span><br/>
                    <button class="transactionCalculateButton" type="submit">Confirm and Connect Bank</button>
                </form>
            </div>
        </div>
        </div>
    </div>
</div>
                    
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}