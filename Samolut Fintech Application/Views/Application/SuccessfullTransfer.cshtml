<body>
    <div class="topDisplay">
        <h2>Samolut Payments</h2>
    </div>
    <div class="applicationBox">
    <div class="TransferBox">
        <div class="placeConfirmBox">
            <div class="confirmInfoBox">
                <a class="confirmText" id="transactionConfirmed">Transaction Confirmed</a>

                <p class="confirmText">Amount Received in Native Currency: @ViewBag.AMOUNT @ViewBag.RECEIVER_ACCOUNT_NAME</p>
                <p class="confirmText">Exchange rate (@ViewBag.SENDER_ACCOUNT_NAME to @ViewBag.RECEIVER_ACCOUNT_NAME): @ViewBag.EXCHANGE_RATE </p>
                <p class="confirmText">Sent from: @ViewBag.SENDER_ACCOUNT_NAME</p>
                <a href="/Application/ApplicationHome" class="transactionCalculateButton" id="returnButton">Return</a>

            </div>
        </div>
    </div>
    </div>
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}