@model Samolut_Fintech_Application.Models.Transfers.ExternalCustomerModel
@*make navbar glow on roght page*@
<style>
    #Payments {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Payments:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>


<body>
    <div class="topDisplay">
        <h2>Samolut Payments</h2>
    </div>

    <div class="mainAppSpace">
        <div class="applicationBox">
            
            
            @* learnt tht these are razor comments and they can be used anywhere and dont show on inspect element*@
            
                <div class="TransferBox">
                    <form asp-action="ReceiveExternalCustomer" method="post">
                        @Html.AntiForgeryToken()
                        <label for="PHONE_NUMBER">Type the phone number of the recipients account you want to transfer money to.</label>
                        <input type="tel" asp-for="PHONE_NUMBER" required/>
                        
                        <label for="FULL_NAME">Type the full name of the recipient account. (First and Last Name)</label>
                        <input  type="text" asp-for="FULL_NAME" required/>
                        
                        <button type="submit">Check Recipient Details</button>
                        
                        <span>@ViewBag.ConfirmMessage</span>
                    </form>
                    @if (ViewBag.ExternalName != null)
                    {
                        //form to go to the transaction page
                        <form asp-action="TransferToExternal">
                            @Html.AntiForgeryToken()

                            <p>To continue with transaction for @ViewBag.ExternalName.</p>
                            <input hidden value="@ViewBag.ExternalID" asp-for="CUSTOMER_ID"/>
                            <button type="submit">Confirm Transfer Recipient</button>
                        </form>
                    }
                    
                </div>
            
                

        </div>
    </div>
                    
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}