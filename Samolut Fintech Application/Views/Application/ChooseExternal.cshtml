@model Samolut_Fintech_Application.Models.Transfers.ExternalCustomerModel
@*make navbar glow on roght page*@
<style>
    #Payments {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Payments:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>


<body>
    <div class="topDisplay">
        <h2>Samolut Payments</h2>
    </div>

    <div class="mainAppSpace">
        <div class="applicationBox">
            
            
            @* learnt tht these are razor comments and they can be used anywhere and dont show on inspect element*@
            
            <div class="TransferBox">
                <form asp-action="ReceiveExternalCustomer" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="leftTransferBox">
                        <label class="transactionText" for="PHONE_NUMBER">Type the Phone Number of the Recipients Account you want to transfer money to.</label>
                        <input class="accountsTransactionAmount" type="tel" asp-for="PHONE_NUMBER" required/>
                    
                    </div>
                    
                    <div class="rightTransferBox">
                        <label class="transactionText" for="FULL_NAME">Type the Full Name of the Recipient's account. (First and Last Name)</label>
                        <input class="accountsTransactionAmount" type="text" asp-for="FULL_NAME" required/>
                    
                        <button class="transactionCalculateButton" type="submit">Check Recipient Details</button>

                        <span class="transactionText" id="externalMessage">@ViewBag.ConfirmMessage</span>
                        
                    </div>
                </form>
                @if (ViewBag.ExternalName != null)
                {
                    //form to go to the transaction page
                    <div class="confirmInfoBox">
                        <form asp-action="TransferToExternal">
                            @Html.AntiForgeryToken()

                            <pc class="transactionText" id="externalConfirm">To continue with transaction for @ViewBag.ExternalName</pc><br/>
                            <input hidden value="@ViewBag.ExternalID" asp-for="CUSTOMER_ID"/>
                            <button class="transactionCalculateButton" type="submit">Confirm Transfer Recipient</button>
                        </form>
                    </div>
                }

            </div>
            
                

        </div>
    </div>
                    
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}