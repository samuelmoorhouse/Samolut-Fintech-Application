@model IEnumerable<Samolut_Fintech_Application.Models.DatabaseModels.Account>
@*make navbar glow on roght page*@
<style>
    #Home {
        background-color: rgba(98, 204, 141, 0.5);
    }

        #Home:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }
</style>

<body>
<div class="mainAppSpace">
    <div class="applicationBox">
        <div class="currentSelectedAccountBox">
            @* select account id is  i know what account is selected so i can then display whatever else *@
            <div class="accountSelectedBox">
                <div class="accountImidiarteInfo">
                    <h1>@ViewBag.ACCOUNT_BALANCE</h1>
                    <h2>@ViewBag.COUNTRY_CURRENCY_NAME</h2>
                </div>
                
            </div>
            <form class="accountSelectionHome" asp-action="ApplicationHome" method="get"> @*get not posttt*@
                <h2 class="welcomeMessage">Welcome back @ViewBag.CustomerName!</h2>
                @Html.AntiForgeryToken()
                <select class="accountsHomeSelect" name="AccountForm">
                    <option value="" asp-for="ACCOUNT_ID"id="options">Select Different Currency Account:</option>
                    @{
                        foreach (var i in Model)
                        {
                            <option  id="options" value="@i.ACCOUNT_ID">@i.CurrencyIdForeignKey.COUNTRY_CURRENCY_NAME - @i.ACCOUNT_BALANCE</option>

                        }
                    }
                </select>
                <button class="changeAccountButton" type="submit">Change Account</button>
            </form>
        </div>

        <div class="HistoryBox">
            @*for transactions to be displayed only if somethings selecte, so chgecking it againsta a viewbag i used above*@
            @{
                //for welcome messge
                if (ViewBag.WelcomeMessage != null || ViewBag.WelcomeMessage != "")
                {
                    <span>@ViewBag.WelcomeMessage</span>
                }
                    
                if (ViewBag.SelectedTransactions != null)
                {
                    <div class="transactionTableBox">
                        
                            @{
                                if (ViewBag.SelectedTransactions != null)
                                {
                                    foreach (var i in ViewBag.SelectedTransactions)
                                    {
                                        
                                        if (i.SenderAccountIdForeignKey.CUSTOMER_ID == ViewBag.CUSTOMER_ID)
                                        {
                                            //for internal transactions so essentialy writting transactions down differently
                                            if (i.ReceiverAccountIdForeignKey.CUSTOMER_ID == ViewBag.CUSTOMER_ID)
                                            {
                                                <div class="singleTransactionsBox">
                                                    <div class="leftOfTransaction">
                                                        <p class="transactionMessage">Exchanged Money From @i.SenderAccountIdForeignKey.ACCOUNT_NAME To @i.ReceiverAccountIdForeignKey.ACCOUNT_NAME<p>
                                                        <p class="timeAndExchangeRate">@i.TRANSACTION_TIME
                                                            Exhange rate of: @i.EXCHANGE_RATE</p>
                                                    </div>
                                                    <div>
                                                        <p class="amount">@i.ReceiverAccountIdForeignKey.CurrencyIdForeignKey.CURRENCY_ICON@i.AMOUNT<p>
                                                    </div>
                                                </div>
                                            } else if (i.ReceiverAccountIdForeignKey.CUSTOMER_ID != ViewBag.CUSTOMER_ID)
                                            {
                                                //not internal
                                                <div class="singleTransactionsBox">
                                                    <div class="leftOfTransaction">
                                                        @ViewBag.ReceiverName
                                                        <p class="transactionMessage">Sent Money To @i.ReceiverAccountIdForeignKey.CustomerIdForeignKey.FIRST_NAME @i.ReceiverAccountIdForeignKey.CustomerIdForeignKey.LAST_NAME's @i.ReceiverAccountIdForeignKey.ACCOUNT_NAME<p>
                                                        <p class="timeAndExchangeRate">@i.TRANSACTION_TIME
                                                            Exhange rate of: @i.EXCHANGE_RATE</p>
                                                    </div>
                                                    <div>
                                                        <p class="amount">- @i.ReceiverAccountIdForeignKey.CurrencyIdForeignKey.CURRENCY_ICON@i.AMOUNT <p>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            //sent by other peopple
                                            <div class="singleTransactionsBox">
                                                <div class="leftOfTransaction">
                                                    @ViewBag.ReceiverName
                                                    <p class="transactionMessage">Received Money From @i.SenderAccountIdForeignKey.CustomerIdForeignKey.FIRST_NAME @i.SenderAccountIdForeignKey.CustomerIdForeignKey.LAST_NAME's @i.SenderAccountIdForeignKey.ACCOUNT_NAME
                                                    <p>
                                                    <p class="timeAndExchangeRate">@i.TRANSACTION_TIME
                                                        Exhange rate of: @i.EXCHANGE_RATE</p>
                                                </div>
                                                <div>
                                                    <p class="amount">@i.ReceiverAccountIdForeignKey.CurrencyIdForeignKey.CURRENCY_ICON@i.AMOUNT</p>
                                                </div>
                                            </div>
                                        }
                                        
                                        
                                            
                                    }
                                }

                            }
                    </div>
                }
            }
        </div>
                
           
    </div>
</div>
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}