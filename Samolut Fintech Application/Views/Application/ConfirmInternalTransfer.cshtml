@model Samolut_Fintech_Application.Models.Transfers.InternalCurrencyModel
<body>
    <div class="topDisplay">
        <h2>Samolut Payments</h2>
    </div>

    <a>Amount to be Sent: @ViewBag.SenderAccountSymbol@ViewBag.OrginalAmount @ViewBag.SenderAccountName </a>
    <a>Exchange rate: @ViewBag.ReceiverAccountSymbol@Model.EXCHANGE_RATE @ViewBag.SenderAccountName to @ViewBag.ReceiverAccountName</a>
    <a>Amount to be Received in Native Currency: @Model.AMOUNT @ViewBag.ReceiverAccountName</a>

    <form asp-action="ConfirmInternalTransfer" method="post">
        <button name="calculateButton" class="SendMoneySubmit" type="submit">Confirm and Send</button>
        
        <span class="errorMessages">@ViewBag.ErrorMessage</span>
    </form>
    
</body>