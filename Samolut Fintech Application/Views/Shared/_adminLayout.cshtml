<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Samolut Admin</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
<div class="mainAppNavLeft">

    <div class="nav">
        <div class="Logo">
            <p class="LogoSamolut">Samolut Admin<p>
        </div>
        <div class="individualNavContainer" id="Home">
            <a class="mainLink" href="/Admin/Activity">Review Activity</a>
        </div>
        <div class="individualNavContainer">
            <a class="mainLink" href="/Application/LogOut">Log Out</a>
        </div>

    </div>
</div>
<main role="main">
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>