@model Samolut_Fintech_Application.Models.DatabaseModels.SuspiciousTransaction
@{
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}
<body>
<div class="mainAppSpace">
    <div class="applicationBox">
        <p class="transactionText" >The suspend transaction reason is written by the user when they see there account is suspended. (If empty, wait for user to submit a reason before reviewing and unsuspending)</p>
        <p class="transactionText">After review, ban or un-suspend their account.</p>
        @*for transactions to be displayed only if somethings selecte, so chgecking it againsta a viewbag i used above*@
        @{
            if (ViewBag.SuspisiousTransactions != null)
            {
                    foreach (var i in ViewBag.SuspisiousTransactions)
                    {
                        <div class="singleTransactionsBox">
                            <div class="leftOfTransaction">
                                <p class="transactionMessage">@i.SenderAccountIdForeignKey.CustomerIdForeignKey.FIRST_NAME @i.SenderAccountIdForeignKey.CustomerIdForeignKey.LAST_NAME's Suspended</p>
                                <p class="timeAndExchangeRate">Sent From @i.SenderAccountIdForeignKey.ACCOUNT_NAME To @i.ReceiverAccountIdForeignKey.ACCOUNT_NAME</p>
                                <p class="timeAndExchangeRate">@i.TRANSACTION_TIME
                                    Exhange rate of: @i.EXCHANGE_RATE</p>
                                <p class="timeAndExchangeRate">Reason Submitted: @i.SUSPENDED_TRANSACTION_REASON

                            </div>
                            <div>
                                <p class="amount">@i.ReceiverAccountIdForeignKey.CurrencyIdForeignKey.CURRENCY_ICON@i.AMOUNT</p>
                                
                            </div>
                            <form asp-action="UnSuspend" method="post">
                                <input name="SUSPENDED_TRANSACTION_ID" value="@i.SUSPENDED_TRANSACTION_ID" hidden/>
                                <button class="transactionCalculateButton" styles="width:100px;" type="submit">Un-Suspend Account</button>
                            </form>
                            <form asp-action="BanAccount">
                                <input name="SUSPENDED_TRANSACTION_ID" value="@i.SUSPENDED_TRANSACTION_ID" hidden/>
                                <button class="transactionCalculateButton" styles="width:100px;" type="submit">Ban Account</button>
                            </form>
                        </div>
                    }
                }
        }
    </div>
    </div>
</body>






@* for all my asp validation stuff to actually show up in the form*@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}