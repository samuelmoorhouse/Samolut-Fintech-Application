@model Samolut_Fintech_Application.Models.DatabaseModels.SuspiciousTransaction
@{
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}
<body>
<div class="mainAppSpace">
    <div class="HistoryBox">
        <p>The suspend transaction reason is written by the user when they see there account is suspended. (If empty, wait for user to submit a reason before reviewing and unsuspending)</p>
        <p>After review, ban or un-suspend their account.</p>
        <h3>Review Accounts</h3>
        @*for transactions to be displayed only if somethings selecte, so chgecking it againsta a viewbag i used above*@
        @{
            if (ViewBag.SuspisiousTransactions != null)
            {
                <div class="transactionTableBox">
                    <table>
                        <thead>
                        <tr>
                            <th>Sender</th>
                            <th>Suspended Transaction Reason</th>
                            <th>Receiver</th>
                            <th>Date</th>
                            <th>Start Currency</th>
                            <th>End Currency</th>
                            <th>Exchange Rate</th>
                            <th>Amount</th>
                            <th>Button to Un-Suspend</th>
                            <th>Button to Ban Account</th>


                        </tr>
                        </thead>
                        <tbody>
                        @{

                            foreach (var i in ViewBag.SuspisiousTransactions)
                            {
                                <tr>
                                    <td>@i.SENDER_ACCOUNT_ID</td>
                                    <td>@i.SUSPENDED_TRANSACTION_REASON</td>
                                    <td>@i.RECEIVER_ACCOUNT_ID</td>
                                    <td>@i.TRANSACTION_TIME</td>
                                    <td>@i.START_CURRENCY</td>
                                    <td>@i.END_CURRENCY</td>
                                    <td>@i.EXCHANGE_RATE</td>
                                    <td>@i.AMOUNT</td>
                                    <th><form asp-action="UnSuspend" method="post">
                                            <input name="SUSPENDED_TRANSACTION_ID" value="@i.SUSPENDED_TRANSACTION_ID" hidden/>
                                            <button type="submit">Un-Suspend Account</button>
                                        </form>  
                                    </th>
                                    <th><form asp-action="BanAccount">
                                            <input name="SUSPENDED_TRANSACTION_ID" value="@i.SUSPENDED_TRANSACTION_ID" hidden/>
                                            <button type="submit">Ban Account</button>
                                        </form> 
                                    </th>
                                </tr>
                            }

                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
    </div>
</body>






@* for all my asp validation stuff to actually show up in the form*@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}